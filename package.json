{
  "name": "mf550-webar",
  "version": "2.2.0",
  "private": true,
  "description": "Mist-Fit 550 WebAR assembly instructions by AEROEX Technologies: Raspberry Pi performance profiles, natural neural-voice narration (pre-recorded), automatic close-up camera, right-hand gesture navigation (MediaPipe), 6x exploded view, BOM and WebXR AR, generated from a STEP CAD file.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "start:https": "node tools/serve.mjs --https --cert certs/cert.pem --key certs/key.pem",
    "convert": "python3 pipeline/convert_step.py",
    "build:usdz": "node tools/build-usdz.cjs",
    "test": "node tests/smoke.cjs",
    "narration": "python3 tools/narration/generate.py",
    "narration:verify": "python3 tools/narration/verify.py",
    "model:tiers": "node tools/optimize-model.mjs",
    "camera:plans": "node tools/precompute-camera.cjs",
    "unit:review": "node tools/unit-review.cjs",
    "unit:analyse": "python3 pipeline/unit/analyse_unit.py MF-550-210-B_GROUPED_ASSEMBLY.step",
    "unit:tools": "python3 pipeline/unit/build_tools.py <dir-with-tool-STEPs> public/assets/unit/tools",
    "unit:build": "python3 pipeline/unit/build_unit.py"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@iwer/sem": "2.8.0",
    "gltfpack": "1.3.0",
    "iwer": "2.8.0",
    "meshoptimizer": "^0.25.0",
    "playwright": "^1.50.0"
  }
}
